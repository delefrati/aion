# ──────────────────────────────────────────────
# AION LLM Lab — Environment Configuration
# Copy to aion_v3/.env and adjust as needed
# ──────────────────────────────────────────────

# Operating mode: nano | standard | lab
AION_MODE=nano

# Model provider: deterministic | local-mamba | local-transformer | hf-local
AION_PROVIDER=deterministic

# Backend
AION_HOST=0.0.0.0
AION_PORT=8900
AION_DB_PATH=data/aion.db
AION_DATABASE_URL=postgresql://aion:aion@postgres:5432/aion
AION_MAX_TOKENS_PER_REQUEST=512

# Local Mamba model (set these when using AION_PROVIDER=local-mamba)
# AION_MAMBA_MODEL_PATH=/app/lab-data/aion_checkpoints/mamba_chat_medium/best.pt
# AION_MAMBA_TOKENIZER_PATH=/app/lab-data/aion_checkpoints/mamba_chat_multi/tokenizer.json
# AION_MAMBA_CONFIG_PATH=/app/lab-data/aion_checkpoints/mamba_chat_medium/run.yaml
AION_MODEL_DEVICE=cpu

# HuggingFace local model (used when AION_PROVIDER=hf-local)
AION_HF_MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
AION_HF_MAX_NEW_TOKENS=256
AION_HF_TORCH_DTYPE=auto

# PostgreSQL (Standard mode only)
POSTGRES_USER=aion
POSTGRES_PASSWORD=aion
POSTGRES_DB=aion

# BFF (Standard mode only)
BFF_PORT=3901
BACKEND_URL=http://localhost:8900

# Frontend
VITE_API_BASE=http://localhost:8900
